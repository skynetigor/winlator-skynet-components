 namespace FEX::HLE {
+// A file on a noexec mount (Android's shared storage) cannot be mapped with PROT_EXEC. The host never executes guest memory (the JIT only
+// reads it), so a refused executable mapping is retried without PROT_EXEC.
+static void* MmapGuest(void* addr, size_t length, int prot, int flags, int fd, off_t offset) {
+  void* Result = ::mmap(addr, length, prot, flags, fd, offset);
+  if (Result == MAP_FAILED && fd != -1 && (prot & PROT_EXEC) && (errno == EACCES || errno == EPERM)) {
+    Result = ::mmap(addr, length, prot & ~PROT_EXEC, flags, fd, offset);
+  }
+  return Result;
+}
+
