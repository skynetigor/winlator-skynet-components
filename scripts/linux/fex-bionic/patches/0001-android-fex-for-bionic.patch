diff --git a/AndroidCompat.h b/AndroidCompat.h
new file mode 100644
index 0000000..9bd6056
--- /dev/null
+++ b/AndroidCompat.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: MIT
+// What Android's libc (bionic) does not have, for the Android build of FEX. Force-included into every file by CMake.
+#pragma once
+#ifdef __ANDROID__
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#ifndef MFD_CLOEXEC
+#define MFD_CLOEXEC 0x0001U
+#endif
+#ifndef ELF32_ST_VISIBILITY
+#define ELF32_ST_VISIBILITY(o) ((o) & 0x3)
+#endif
+
+#ifdef __cplusplus
+extern "C++" {
+#endif
+
+// No wrappers in bionic at this API level; the syscalls are the kernel's own.
+static inline int fex_android_memfd_create(const char* name, unsigned int flags) {
+  return (int)syscall(SYS_memfd_create, name, flags);
+}
+static inline ssize_t fex_android_getdents64(int fd, void* buffer, size_t count) {
+  return syscall(SYS_getdents64, fd, buffer, count);
+}
+
+// Android has no POSIX shared memory (no /dev/shm): an object becomes a file in FEX_SHM_DIR (TMPDIR when it is not set),
+// which the app points at a folder of its own. FEX only shares these between itself and FEXServer.
+static inline void fex_android_shm_path(const char* name, char* out, size_t size) {
+  const char* dir = getenv("FEX_SHM_DIR");
+  if (!dir || !*dir) {
+    dir = getenv("TMPDIR");
+  }
+  if (!dir || !*dir) {
+    dir = "/data/local/tmp";
+  }
+  while (*name == '/') {
+    ++name;
+  }
+  snprintf(out, size, "%s/fex-shm-%s", dir, name);
+}
+static inline int fex_android_shm_open(const char* name, int oflag, mode_t mode) {
+  char path[512];
+  fex_android_shm_path(name, path, sizeof path);
+  return open(path, oflag, mode);
+}
+static inline int fex_android_shm_unlink(const char* name) {
+  char path[512];
+  fex_android_shm_path(name, path, sizeof path);
+  return unlink(path);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#define memfd_create fex_android_memfd_create
+#define getdents64 fex_android_getdents64
+#define shm_open fex_android_shm_open
+#define shm_unlink fex_android_shm_unlink
+#endif
