+// The host maps things the bitmap does not know about (libraries, stacks, the thunk areas). When a fixed mapping in a range the bitmap
+// calls free fails with EEXIST, record every host mapping that overlaps [FirstPage, EndPage) as used so the scan skips it in one step;
+// stepping one page at a time costs a system call per page. Returns whether any page was newly marked.
+bool MemAllocator32Bit::AdoptHostMappings(uint64_t FirstPage, uint64_t EndPage) {
+  const int MapsFD = ::open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+  if (MapsFD == -1) {
+    return false;
+  }
+
+  bool Marked = false;
+  char Buffer[4096];
+  size_t Filled = 0;
+  bool Eof = false;
+  while (!Eof) {
+    const ssize_t Read = ::read(MapsFD, Buffer + Filled, sizeof(Buffer) - 1 - Filled);
+    if (Read < 0 && errno == EINTR) {
+      continue;
+    }
+    if (Read <= 0) {
+      Eof = true;
+    } else {
+      Filled += Read;
+    }
+    Buffer[Filled] = 0;
+
+    // Handle the complete lines; a partial one stays for the next read.
+    char* Line = Buffer;
+    for (;;) {
+      char* Newline = strchr(Line, '\n');
+      if (!Newline && !Eof) {
+        break;
+      }
+      if (Newline) {
+        *Newline = 0;
+      }
+      char* Cursor {};
+      const uint64_t Begin = strtoull(Line, &Cursor, 16);
+      if (Cursor != Line && *Cursor == '-') {
+        const uint64_t End = strtoull(Cursor + 1, &Cursor, 16);
+        const uint64_t First = std::max<uint64_t>(Begin >> FEXCore::Utils::FEX_PAGE_SHIFT, FirstPage);
+        const uint64_t Last = std::min<uint64_t>(FEXCore::AlignUp(End, FEXCore::Utils::FEX_PAGE_SIZE) >> FEXCore::Utils::FEX_PAGE_SHIFT, EndPage);
+        for (uint64_t Page = First; Page < Last; ++Page) {
+          if (!MappedPages.test(Page)) {
+            MappedPages.set(Page);
+            Marked = true;
+          }
+        }
+      }
+      if (!Newline) {
+        Line += strlen(Line);
+        break;
+      }
+      Line = Newline + 1;
+    }
+    Filled = strlen(Line);
+    memmove(Buffer, Line, Filled);
+    if (Filled == sizeof(Buffer) - 1) {
+      // A line longer than the buffer is not a maps line.
+      Filled = 0;
+    }
+  }
+  ::close(MapsFD);
+  return Marked;
+}
