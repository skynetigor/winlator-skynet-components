{
  "format": "winlator-skynet-container",
  "version": 1,
  "exportedBy": "SkyNetEmu 2.0.1",
  "components": [
    {
      "type": "Proton",
      "version": "proton-9.0-arm64ec"
    },
    {
      "type": "GraphicsDriver",
      "version": "DD-Turnip v0.1.1",
      "remoteUrl": "https://github.com/Droid-Deck/Drivers-CI/releases/download/DD-Turnip-v0.1.1/DD-Turnip-v0.1.1.zip"
    },
    {
      "type": "RendererDriver",
      "version": "DD-Turnip v0.1.1",
      "remoteUrl": "https://github.com/Droid-Deck/Drivers-CI/releases/download/DD-Turnip-v0.1.1/DD-Turnip-v0.1.1.zip"
    }
  ],
  "container": {
    "screenSize": "1280x720",
    "cpuList": "4,5,6,7",
    "cpuListWoW64": "4,5,6,7",
    "graphicsDriver": "freedreno",
    "graphicsDriverConfig": "vulkanVersion=1.3;version=DD-Turnip v0.1.1;blacklistedExtensions=VK_EXT_debug_utils,VK_EXT_debug_report;maxDeviceMemory=4096;presentMode=mailbox;syncFrame=0;disablePresentWait=0;resourceType=auto;bcnEmulation=auto;bcnEmulationType=compute;bcnEmulationCache=0;gpuName=Device",
    "rendererNative": false,
    "rendererPresentMode": "mailbox",
    "rendererDriverId": "DD-Turnip v0.1.1",
    "audioDriver": "alsa",
    "showFPS": true,
    "fullscreenStretched": false,
    "inputType": 4,
    "startupSelection": 1,
    "desktopTheme": "DARK,IMAGE,#0277bd,0",
    "midiSoundFont": "",
    "lc_all": "",
    "primaryController": 1,
    "controllerMapping": "\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000",
    "exclusiveXInput": true,
    "type": "wine",
    "name": "BeamNG.drive 0.40, Windows ARM64 native",
    "wineVersion": "proton-9.0-arm64ec",
    "envVars": "WINEESYNC=0 WINEFSYNC=0 WINEDLLOVERRIDES=browseui= WRAPPER_EXTENSION_BLACKLIST=VK_EXT_debug_utils,VK_EXT_debug_report MESA_GL_VERSION_OVERRIDE=3.3",
    "dxwrapper": "wined3d",
    "dxwrapperConfig": "",
    "wincomponents": "direct3d=0,directsound=0,directmusic=0,directshow=0,directplay=0,xaudio=0,vcrun2010=0",
    "extraData": {
      "hudMode": "2",
      "mouseWarpOverride": "disable",
      "useDisplayX": "0",
      "surfaceFormat": "bgra8",
      "trueDisplayX": "0",
      "displayXPerformanceMode": "1",
      "displayXPresentAtRefreshRate": "1",
      "displayXBackPressure": "0",
      "displayXPrecisePresentation": "0",
      "oboeProfile": "low",
      "oboeApi": "auto",
      "oboeAdaptive": "1",
      "oboeExclusive": "0",
      "openGlDefaultInitialized": "1",
      "autoMesaGlVersionOverride": "1",
      "windowsArchitecture": "arm64",
      "lsfgMultiplier": "0",
      "fileCache": "0"
    }
  }
}
