{
  "format": "winlator-skynet-container",
  "version": 1,
  "exportedBy": "SkyNetEmu 2.0.1-pre.3",
  "components": [],
  "container": {
    "type": "linux",
    "name": "BeamNG 0.39, Linux Box64 + bionic, no PRoot, 960x544",
    "screenSize": "960x544",
    "fullscreenStretched": false,
    "rendererDriverId": "auto",
    "linuxRuntime": "bannerlator-r9",
    "cpuList": "2,3,4,5,6,7",
    "extraData": {
      "linuxEmulator": "box64",
      "linuxEmulatorId": "box64-0.4.4-r3",
      "linuxEmulatorPreset": "PERFORMANCE",
      "linuxGlDriver": "zink",
      "linuxVulkanDriver": "turnip-v26.3.0-20261011-a8xx-linux",
      "linuxVulkanPresent": "native",
      "linuxBionic": "1",
      "linuxNoProot": "1",
      "linuxDirectFex": "0",
      "linuxTuSysmem": "0",
      "linuxGpuMemoryMB": "8192",
      "linuxProotMode": "fastpath",
      "linuxIsolateGameGpu": "0",
      "linuxTouchMode": "mouse",
      "linuxKeyboardButton": "1",
      "linuxAutoKeyboard": "1",
      "hudMode": "2",
      "fileCache": "1",
      "graphicsFilterMode": "0",
      "graphicsPostFXMode": "0",
      "graphicsSharpness": "50",
      "lsfgMultiplier": "0",
      "lsfgLayer": "0"
    },
    "graphicsDriverConfig": "vulkanVersion=1.3;version=DD-Turnip v0.1.1;blacklistedExtensions=;maxDeviceMemory=0;presentMode=mailbox;syncFrame=0;disablePresentWait=0;resourceType=auto;bcnEmulation=auto;bcnEmulationType=compute;bcnEmulationCache=0;gpuName=Device"
  }
}
