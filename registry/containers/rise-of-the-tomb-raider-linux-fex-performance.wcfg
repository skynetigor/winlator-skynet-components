{
  "format": "winlator-skynet-container",
  "version": 1,
  "exportedBy": "SkyNetEmu 2.0.0",
  "components": [],
  "container": {
    "type": "linux",
    "name": "Rise of the Tomb Raider, Linux (FEX)",
