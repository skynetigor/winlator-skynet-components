      "linuxVulkanPresent": "native",
      "linuxTouchscreen": "1",
      "linuxKeyboardButton": "1",
      "linuxAutoKeyboard": "1",
      "linuxNoProot": "0",
      "lsfgMultiplier": "0"
    }
  }
