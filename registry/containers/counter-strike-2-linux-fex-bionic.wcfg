{
  "format": "winlator-skynet-container",
  "version": 1,
  "exportedBy": "SkyNetEmu 2.0.1-pre.3",
  "components": [],
  "container": {
    "type": "linux",
    "name": "Counter-Strike 2, Linux FEX + bionic, no PRoot, 8 cores",
    "screenSize": "native",
    "fullscreenStretched": true,
    "rendererDriverId": "auto",
    "linuxRuntime": "bannerlator-r9",
    "cpuList": "0,1,2,3,4,5,6,7",
    "extraData": {
      "linuxEmulator": "fex",
      "linuxEmulatorId": "fex-2610",
      "linuxFexPreset": "PERFORMANCE",
      "linuxRootfsId": "rootfs-ubuntu-24-04-2026-08-11",
      "linuxFexThunks": "1",
      "linuxFexGl32": "1",
      "linuxGlVendor": "nvidia",
      "linuxTuSysmem": "0",
      "linuxBionic": "1",
      "linuxVulkanDriver": "turnip-v26.3.0-20261011-a8xx-linux",
      "linuxGlDriver": "zink",
      "linuxVulkanPresent": "native",
      "linuxProotMode": "runtime",
      "linuxGpuMemoryMB": "0",
      "linuxIsolateGameGpu": "0",
      "linuxTouchMode": "mouse",
      "linuxKeyboardButton": "1",
      "linuxAutoKeyboard": "1",
      "linuxNoProot": "1",
      "linuxDirectFex": "1",
      "hudMode": "2",
      "graphicsFilterMode": "0",
      "lsfgMultiplier": "0",
      "lsfgLayer": "1"
    },
    "graphicsDriverConfig": "vulkanVersion=1.3;version=;blacklistedExtensions=;maxDeviceMemory=0;presentMode=mailbox;syncFrame=0;disablePresentWait=0;resourceType=auto;bcnEmulation=auto;bcnEmulationType=compute;bcnEmulationCache=0;gpuName=Device"
  }
}
