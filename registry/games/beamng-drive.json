  "versions": [
    {
      "id": "0.40",
      "label": "0.40.x",
      "preferredPlatform": "linux",
      "status": "works",
      "default": true,
      "notes": "FEX 2610 + bionic, no PRoot, direct launch, 960x544 (preset beamng-040-linux-fex-bionic-960x544): the only preset for this version. On a Redmagic Astra 2 with BeamNG 0.40.4, Lowest graphics, West Coast, no traffic: about 73 FPS average (1% low 45) over three runs. Long-run performance is not established; uncapped testing reached Android thermal limits.",
      "testedOn": "Samsung Galaxy Z Fold8 Ultra (SM-F976B), Snapdragon 8 Elite Gen 5; Redmagic Astra 2 (SM8850P), Android 16 (FEX preset, 0.40.4)",
      "match": {
        "versionFile": {
          "path": "integrity.json",
          "tail": 256,
          "regex": "\"version\":\\s*\"([0-9.]+)\"",
          "from": "0.40",
          "until": "0.41"
        }
      },
      "containers": [
        "beamng-040-linux-fex-bionic-960x544"
      ],
      "preferredContainer": "beamng-040-linux-fex-bionic-960x544",
      "linux": {
        "userData": {
          "arg": "-userpath",
          "links": {
            "current/settings": "userdata/settings",
            "current/mods": "userdata/mods"
          }
        },
        "resolution": "native",
        "extras": {
          "linuxTouchMode": "touchpad",
          "simTouchScreen": "0",
          "lsfgMultiplier": "0"
        },
        "env": {
          "MESA_SHADER_CACHE_DISABLE": "false",
          "FEX_DISABLEL2CACHE": "1",
          "FEX_DYNAMICL1CACHE": "1",
          "FEX_DYNAMICL1CACHEINCREASECOUNTHEURISTIC": "250",
          "FEX_DYNAMICL1CACHEDECREASECOUNTHEURISTIC": "50"
        }
      }
    },
