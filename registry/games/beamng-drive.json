{
  "schema": 1,
  "revision": 9,
  "id": "beamng-drive",
  "name": "BeamNG.drive",
  "steam": {
    "appId": 284160,
    "installDir": "BeamNG.drive"
  },
  "windows": {
    "executables": [
      "BeamNG.drive.exe",
      "Bin64/BeamNG.drive.x64.exe",
      "BinArm64/BeamNG.drive.arm64.exe"
    ]
  },
  "linux": {
    "executables": [
      "BinLinux/BeamNG.drive.x64"
    ],
    "defaults": {
      "executable": "BinLinux/BeamNG.drive.x64",
      "noSteam": {
        "default": true,
        "arg": "-nosteam"
      },
      "extras": {
        "linuxNoProot": "0"
      }
    }
  },
  "defaults": {
    "args": [],
    "extras": {
      "fileCache": "1"
    }
  },
  "versions": [
    {
      "id": "0.40",
      "label": "0.40.x",
      "status": "works",
      "default": true,
      "notes": "Native Linux x86-64: startup and Automation Test Track loading verified with Box64 0.4.4-r3 on Snapdragon 8 Elite Gen 5. Windows ARM64: retain Proton 9 ARM64EC with DD-Turnip native Vulkan and the current device GPU identity. Proton 9 previously loaded GridMapv2; standard Proton 11 and CachyOS 11 failed during Vulkan device creation on the test device. The ARM64 profile remains experimental.",
      "testedOn": "Samsung Galaxy Z Fold8 Ultra (SM-F976B), Snapdragon 8 Elite Gen 5",
      "match": {
        "versionFile": {
          "path": "integrity.json",
          "tail": 256,
          "regex": "\"version\":\\s*\"([0-9.]+)\"",
          "from": "0.40",
          "until": "0.41"
        }
      },
      "containers": [
        "beamng-linux-box64-adreno735-performance",
        "beamng-040-linux-box64-r3",
        "beamng-040-windows-arm64-proton9-dd-turnip-device"
      ],
      "preferredContainer": "beamng-040-linux-box64-r3",
      "linux": {
        "resolution": "native",
        "extras": {
          "linuxTouchMode": "touchpad",
          "simTouchScreen": "0",
          "lsfgMultiplier": "0"
        }
      },
      "preferredBySoc": {
        "snapdragon-8s-gen-3": "beamng-linux-box64-adreno735-performance"
      }
    },
