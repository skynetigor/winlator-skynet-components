  "versions": [
    {
      "id": "0.40",
      "label": "0.40.x",
      "status": "works",
      "default": true,
      "notes": "Native Linux 0.40.1 x86-64: startup, CEF UI and Smallgrid rendering verified with published Box64 0.4.4-r4 on Snapdragon 8 Elite Gen 5. Main plus seven CEF helpers shared one read-only libcef code-cache inode; r4 is required for ELF caching, and existing shortcuts must select it explicitly. The preset keeps its legacy r3 identifier for compatibility but selects r4. BOX64_DYNAREC_STRONGMEM=1 retains limited x86 memory ordering: three consecutive cached menu launches passed with this setting after an intermittent CEF renderer crash under PERFORMANCE/STRONGMEM=0; this is a tested mitigation, not proof of the crash's root cause or long-run stability. Existing shortcuts must also apply this environment setting explicitly. Earlier Automation Test Track loading was verified on r3. Long-run performance is not established; uncapped testing reached Android thermal limits. Windows ARM64: retain Proton 9 ARM64EC with DD-Turnip native Vulkan and the current device GPU identity. Disable windows.ui in the ARM64 preset DLL overrides to avoid UISettings text-scaling recursion and a startup stack overflow; the 0.40.1 first-run UI was verified with this workaround. Proton 9 previously loaded GridMapv2; standard Proton 11 and CachyOS 11 failed during Vulkan device creation on the test device. The ARM64 profile remains experimental.",
      "testedOn": "Samsung Galaxy Z Fold8 Ultra (SM-F976B), Snapdragon 8 Elite Gen 5",
      "match": {
        "versionFile": {
          "path": "integrity.json",
          "tail": 256,
          "regex": "\"version\":\\s*\"([0-9.]+)\"",
          "from": "0.40",
          "until": "0.41"
        }
      },
      "containers": [
        "beamng-linux-box64-adreno735-performance",
        "beamng-linux-box64-adreno730-performance",
        "beamng-linux-box64-adreno740-performance",
        "beamng-040-linux-box64-r3",
        "beamng-040-windows-arm64-proton9-dd-turnip-device"
      ],
      "preferredContainer": "beamng-040-linux-box64-r3",
      "linux": {
        "resolution": "native",
        "extras": {
          "linuxTouchMode": "touchpad",
          "simTouchScreen": "0",
          "lsfgMultiplier": "0"
        }
      },
